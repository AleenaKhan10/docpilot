# Production env template for the Contabo VPS.
# Copy to .env on the server, fill in the real values, NEVER commit.
#
#   ssh root@your-vps-ip
#   cd /home/docpilot/docpilot
#   cp .env.production.example .env
#   nano .env   # paste your values

PROJECT_NAME=DocPilot
APP_BASE_URL=https://app.docpilot.com

# --- Supabase (same project the frontend talks to) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_JWT_SECRET=THE-LONG-SECRET-FROM-SUPABASE-API-SETTINGS
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# --- Database (Supabase Session Pooler URL, NOT direct connection) ---
# Get this from: Supabase Dashboard → Settings → Database → Connection string
# → Session pooler → URI. The password's % characters must be URL-encoded (% → %25).
DATABASE_URL=postgresql+psycopg2://postgres.YOUR-PROJECT:PASSWORD@aws-X-region.pooler.supabase.com:5432/postgres

# --- Redis ---
# In docker-compose we override this to redis://redis:6379/0 — leave as is.
REDIS_URL=redis://redis:6379/0

# --- Gemini (active VLM) ---
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-flash-latest

# --- Resend (transactional email) ---
# RESEND_FROM must use a domain that is verified on Resend, otherwise
# sends 403. Format is "Display Name <address@domain>".
RESEND_API_KEY=re_...
RESEND_FROM=DocPilot <noreply@usedocpilot.com>

# --- Upload limits (override if needed) ---
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=1800
MAX_VIDEOS_PER_ORG_PER_DAY=20

# --- Unused — keep for forward compatibility / fallback ---
NVIDIA_API_KEY=
MODEL_NAME=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
